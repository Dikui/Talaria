{
  "additionalProperties": false,
  "description": "框选或可视窗口：时间闭区间 + 价格闭区间。",
  "properties": {
    "from_ts": {
      "minimum": 0,
      "title": "From Ts",
      "type": "integer"
    },
    "price_max": {
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
      "title": "Price Max",
      "type": "string"
    },
    "price_min": {
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
      "title": "Price Min",
      "type": "string"
    },
    "to_ts": {
      "minimum": 0,
      "title": "To Ts",
      "type": "integer"
    }
  },
  "required": [
    "from_ts",
    "to_ts",
    "price_min",
    "price_max"
  ],
  "title": "CollabWindow",
  "type": "object"
}
