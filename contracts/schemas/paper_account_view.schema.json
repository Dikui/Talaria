{
  "$defs": {
    "Direction": {
      "enum": [
        "LONG",
        "SHORT"
      ],
      "type": "string"
    },
    "ExitBarrierSpec": {
      "additionalProperties": false,
      "properties": {
        "max_holding_ms": {
          "exclusiveMinimum": 0,
          "title": "Max Holding Ms",
          "type": "integer"
        },
        "stop": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Stop",
          "type": "string"
        },
        "take_profit": {
          "items": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Take Profit",
          "type": "array"
        },
        "trailing_stop": {
          "anyOf": [
            {
              "$ref": "#/$defs/TrailingStopSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "stop",
        "take_profit",
        "max_holding_ms"
      ],
      "title": "ExitBarrierSpec",
      "type": "object"
    },
    "MarginMode": {
      "description": "子账户保证金模式。",
      "enum": [
        "ISOLATED",
        "CROSS"
      ],
      "title": "MarginMode",
      "type": "string"
    },
    "PaperAccountState": {
      "additionalProperties": false,
      "description": "子账户资金、风控状态与定仓配置快照。",
      "properties": {
        "cash_available": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Cash Available",
          "type": "string"
        },
        "currency": {
          "default": "USDT",
          "minLength": 1,
          "title": "Currency",
          "type": "string"
        },
        "equity": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Equity",
          "type": "string"
        },
        "friction_buffer_pct": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Friction Buffer Pct"
        },
        "intraday_drawdown_pct": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Intraday Drawdown Pct",
          "type": "string"
        },
        "leverage": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Leverage"
        },
        "liquidation_buffer_pct": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Liquidation Buffer Pct"
        },
        "liquidation_buffer_ticks": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Liquidation Buffer Ticks"
        },
        "margin_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/MarginMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "margin_used": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Margin Used",
          "type": "string"
        },
        "max_single_r_pct": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Single R Pct"
        },
        "open_r": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Open R",
          "type": "string"
        },
        "peak_drawdown_pct": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Peak Drawdown Pct",
          "type": "string"
        },
        "r_unit_pct": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "R Unit Pct"
        },
        "risk_reserved": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Risk Reserved",
          "type": "string"
        },
        "trading_state": {
          "$ref": "#/$defs/TradingState"
        },
        "trading_state_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trading State Reason"
        }
      },
      "required": [
        "equity",
        "cash_available",
        "margin_used",
        "trading_state",
        "intraday_drawdown_pct",
        "peak_drawdown_pct",
        "open_r",
        "risk_reserved"
      ],
      "title": "PaperAccountState",
      "type": "object"
    },
    "PaperFeedStatus": {
      "additionalProperties": false,
      "description": "模拟盘账户进程的行情订阅与服务连通降级状态。",
      "properties": {
        "healthy": {
          "default": true,
          "title": "Healthy",
          "type": "boolean"
        },
        "reduce_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reduce Reason"
        },
        "service_warning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Warning"
        },
        "updated_ts": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated Ts"
        }
      },
      "title": "PaperFeedStatus",
      "type": "object"
    },
    "PaperFill": {
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "fee": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fee"
        },
        "instrument_id": {
          "title": "Instrument Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/PaperFillKind"
        },
        "price": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Price",
          "type": "string"
        },
        "quantity": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Quantity",
          "type": "string"
        },
        "realized_pnl": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Realized Pnl"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "round_id": {
          "title": "Round Id",
          "type": "string"
        },
        "ts_event": {
          "title": "Ts Event",
          "type": "integer"
        }
      },
      "required": [
        "event_id",
        "round_id",
        "instrument_id",
        "kind",
        "ts_event",
        "quantity",
        "price"
      ],
      "title": "PaperFill",
      "type": "object"
    },
    "PaperFillKind": {
      "description": "模拟盘成交事件类型。",
      "enum": [
        "ENTRY_FILLED",
        "EXIT_FILLED"
      ],
      "title": "PaperFillKind",
      "type": "string"
    },
    "PaperProcessInfo": {
      "additionalProperties": false,
      "description": "模拟盘账户进程元数据与心跳信号。",
      "properties": {
        "heartbeat_ts": {
          "minimum": 0,
          "title": "Heartbeat Ts",
          "type": "integer"
        },
        "pid": {
          "minimum": 1,
          "title": "Pid",
          "type": "integer"
        },
        "scheme": {
          "minLength": 1,
          "title": "Scheme",
          "type": "string"
        },
        "started_ts": {
          "minimum": 0,
          "title": "Started Ts",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/PaperProcessState",
          "default": "RUNNING"
        },
        "stopped_ts": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stopped Ts"
        }
      },
      "required": [
        "pid",
        "scheme",
        "started_ts",
        "heartbeat_ts"
      ],
      "title": "PaperProcessInfo",
      "type": "object"
    },
    "PaperProcessState": {
      "description": "模拟盘账户进程存活状态。",
      "enum": [
        "RUNNING",
        "STOPPED",
        "OFFLINE"
      ],
      "title": "PaperProcessState",
      "type": "string"
    },
    "PaperRound": {
      "additionalProperties": false,
      "properties": {
        "barriers": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExitBarrierSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "closed_ts": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Closed Ts"
        },
        "direction": {
          "$ref": "#/$defs/Direction"
        },
        "entry_high": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entry High"
        },
        "entry_low": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entry Low"
        },
        "entry_price": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entry Price"
        },
        "instrument_id": {
          "title": "Instrument Id",
          "type": "string"
        },
        "mark_price": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mark Price"
        },
        "opened_ts": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opened Ts"
        },
        "phase": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phase"
        },
        "quantity": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Quantity",
          "type": "string"
        },
        "round_id": {
          "title": "Round Id",
          "type": "string"
        },
        "stop": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Stop",
          "type": "string"
        },
        "sub_account_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Sub Account Id",
          "type": "string"
        },
        "take_profit": {
          "default": [],
          "items": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": "string"
          },
          "title": "Take Profit",
          "type": "array"
        },
        "unrealized_pnl": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unrealized Pnl"
        }
      },
      "required": [
        "round_id",
        "sub_account_id",
        "instrument_id",
        "direction",
        "quantity",
        "stop"
      ],
      "title": "PaperRound",
      "type": "object"
    },
    "TradingState": {
      "description": "子账户或全局系统交易状态。",
      "enum": [
        "ACTIVE",
        "REDUCING",
        "HALTED"
      ],
      "title": "TradingState",
      "type": "string"
    },
    "TrailingStopSpec": {
      "additionalProperties": false,
      "properties": {
        "activation_pct": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Activation Pct",
          "type": "string"
        },
        "distance_pct": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Distance Pct",
          "type": "string"
        }
      },
      "required": [
        "activation_pct",
        "distance_pct"
      ],
      "title": "TrailingStopSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "account_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/PaperAccountState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "feed_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/PaperFeedStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "fills": {
      "items": {
        "$ref": "#/$defs/PaperFill"
      },
      "title": "Fills",
      "type": "array"
    },
    "ledger_seq": {
      "default": 0,
      "minimum": 0,
      "title": "Ledger Seq",
      "type": "integer"
    },
    "positions": {
      "items": {
        "$ref": "#/$defs/PaperRound"
      },
      "title": "Positions",
      "type": "array"
    },
    "process": {
      "anyOf": [
        {
          "$ref": "#/$defs/PaperProcessInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rounds": {
      "items": {
        "$ref": "#/$defs/PaperRound"
      },
      "title": "Rounds",
      "type": "array"
    },
    "sub_account_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Sub Account Id",
      "type": "string"
    }
  },
  "required": [
    "sub_account_id",
    "positions",
    "rounds",
    "fills"
  ],
  "title": "PaperAccountView",
  "type": "object"
}
