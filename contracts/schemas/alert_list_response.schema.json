{
  "$defs": {
    "AlertCondition": {
      "additionalProperties": false,
      "description": "一条可评估条件；字段组合由 ``kind`` 决定。",
      "properties": {
        "compare_anchor": {
          "anyOf": [
            {
              "enum": [
                "snapshot",
                "session"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compare Anchor"
        },
        "compare_indicator": {
          "anyOf": [
            {
              "$ref": "#/$defs/IndicatorName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "compare_period": {
          "anyOf": [
            {
              "maximum": 5000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compare Period"
        },
        "direction": {
          "anyOf": [
            {
              "$ref": "#/$defs/AlertDirection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "drawing_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Drawing Id"
        },
        "indicator": {
          "anyOf": [
            {
              "$ref": "#/$defs/IndicatorName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "indicator_anchor": {
          "anyOf": [
            {
              "enum": [
                "snapshot",
                "session"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Indicator Anchor"
        },
        "indicator_channel": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Indicator Channel"
        },
        "indicator_period": {
          "anyOf": [
            {
              "maximum": 5000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Indicator Period"
        },
        "kind": {
          "$ref": "#/$defs/AlertConditionKind"
        },
        "level_event": {
          "anyOf": [
            {
              "$ref": "#/$defs/AlertLevelEvent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "level_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Level Id"
        },
        "level_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/KeyLevelKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metric": {
          "anyOf": [
            {
              "$ref": "#/$defs/AlertMetric"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "overlay_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/AlertOverlayMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "overlay_ratio": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Overlay Ratio"
        },
        "threshold": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        }
      },
      "required": [
        "kind"
      ],
      "title": "AlertCondition",
      "type": "object"
    },
    "AlertConditionKind": {
      "description": "规则条件的来源；前端不复制任何指标、几何或关键位数学。",
      "enum": [
        "METRIC_THRESHOLD",
        "INDICATOR_SIGNAL",
        "OVERLAY_CROSS",
        "LEVEL_EVENT"
      ],
      "title": "AlertConditionKind",
      "type": "string"
    },
    "AlertDirection": {
      "description": "比较方向：向上穿越/高于，或向下穿越/低于。",
      "enum": [
        "ABOVE",
        "BELOW"
      ],
      "title": "AlertDirection",
      "type": "string"
    },
    "AlertLevelEvent": {
      "description": "关键位事件：盘中触及、收盘突破、突破后的回踩确认。",
      "enum": [
        "TOUCH",
        "BREAK",
        "RETEST"
      ],
      "title": "AlertLevelEvent",
      "type": "string"
    },
    "AlertMetric": {
      "description": "可直接比较的盘口或衍生品标量。",
      "enum": [
        "last_price",
        "bid_price",
        "ask_price",
        "mark_price",
        "funding_rate",
        "open_interest"
      ],
      "title": "AlertMetric",
      "type": "string"
    },
    "AlertOverlayMode": {
      "description": "画线触发的两种判定：盘中触碰或收盘确认突破。",
      "enum": [
        "TOUCH",
        "CLOSE_BREAK"
      ],
      "title": "AlertOverlayMode",
      "type": "string"
    },
    "AlertRecord": {
      "additionalProperties": false,
      "description": "持久化的规则快照；``status`` 是引擎状态的权威来源。",
      "properties": {
        "alert_id": {
          "title": "Alert Id",
          "type": "string"
        },
        "condition": {
          "$ref": "#/$defs/AlertCondition"
        },
        "cooldown_ms": {
          "title": "Cooldown Ms",
          "type": "integer"
        },
        "created_ts": {
          "title": "Created Ts",
          "type": "integer"
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "instrument_id": {
          "title": "Instrument Id",
          "type": "string"
        },
        "last_triggered_ts": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Triggered Ts"
        },
        "next_arm_ts": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Arm Ts"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "repeat": {
          "title": "Repeat",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/AlertStatus"
        },
        "timeframe": {
          "title": "Timeframe",
          "type": "string"
        },
        "trigger_count": {
          "default": 0,
          "title": "Trigger Count",
          "type": "integer"
        },
        "updated_ts": {
          "title": "Updated Ts",
          "type": "integer"
        }
      },
      "required": [
        "alert_id",
        "instrument_id",
        "timeframe",
        "condition",
        "status",
        "repeat",
        "cooldown_ms",
        "created_ts",
        "updated_ts"
      ],
      "title": "AlertRecord",
      "type": "object"
    },
    "AlertStatus": {
      "description": "规则状态机：草案/待命/冷却/过期/禁用。",
      "enum": [
        "DRAFT",
        "ARMED",
        "COOLDOWN",
        "EXPIRED",
        "DISABLED"
      ],
      "title": "AlertStatus",
      "type": "string"
    },
    "IndicatorName": {
      "description": "技术指标与衍生品指标；全部共用同一算子核。",
      "enum": [
        "EMA",
        "SMA",
        "RSI",
        "ATR",
        "BOLL",
        "VWAP",
        "FUNDING_QUANTILE",
        "OI_DIVERGENCE",
        "NET_ODDS"
      ],
      "title": "IndicatorName",
      "type": "string"
    },
    "KeyLevelKind": {
      "description": "关键位类型；11 的成交量位/清算估算可直接追加而不改类别逻辑。",
      "enum": [
        "SWING_HIGH",
        "SWING_LOW",
        "PREV_DAY_HIGH",
        "PREV_DAY_LOW",
        "PREV_DAY_CLOSE",
        "WEEK_OPEN",
        "MONTH_OPEN",
        "OPENING_RANGE",
        "SESSION_HIGH",
        "SESSION_LOW",
        "GAP",
        "ROUND_NUMBER",
        "POC",
        "VAH",
        "VAL",
        "ANCHORED_VWAP",
        "LIQUIDATION_ZONE"
      ],
      "title": "KeyLevelKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "alerts": {
      "items": {
        "$ref": "#/$defs/AlertRecord"
      },
      "title": "Alerts",
      "type": "array"
    }
  },
  "required": [
    "alerts"
  ],
  "title": "AlertListResponse",
  "type": "object"
}
