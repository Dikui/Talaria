{
  "$defs": {
    "Abstain": {
      "additionalProperties": false,
      "description": "明确的拒绝：原因码 + 人类可读说明 + 可核对的证据引用。",
      "properties": {
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "maxItems": 40,
          "title": "Evidence Refs",
          "type": "array"
        },
        "message": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "reason_code": {
          "$ref": "#/$defs/AbstainReason"
        }
      },
      "required": [
        "reason_code",
        "message"
      ],
      "title": "Abstain",
      "type": "object"
    },
    "AbstainReason": {
      "description": "拒绝给出伪结论的稳定原因码；前端按此渲染黄色降级卡。",
      "enum": [
        "STALE_SNAPSHOT",
        "EVIDENCE_CONFLICT",
        "GEOMETRY_INVERTED",
        "MODEL_TIMEOUT",
        "HOST_OFFLINE",
        "MODEL_INVALID_OUTPUT"
      ],
      "title": "AbstainReason",
      "type": "string"
    },
    "EvidenceKind": {
      "description": "证据来源类别；只允许来自冻结快照内的只读工具或人工画线。",
      "enum": [
        "SNAPSHOT",
        "CHART_VIEW",
        "KEY_LEVEL",
        "INDICATOR",
        "OPERATOR",
        "HUMAN_DRAWING"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "可核对的证据引用；``evidence_id`` 是工具/画线/关键位的稳定 ID。",
      "properties": {
        "detail": {
          "default": "",
          "maxLength": 500,
          "title": "Detail",
          "type": "string"
        },
        "evidence_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "price_high": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price High"
        },
        "price_low": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price Low"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "label"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "SetupDirection": {
      "description": "Setup 的方向；NEUTRAL 只允许描述观望条件，不生成入场几何。",
      "enum": [
        "LONG",
        "SHORT",
        "NEUTRAL"
      ],
      "title": "SetupDirection",
      "type": "string"
    },
    "SetupInsight": {
      "additionalProperties": false,
      "description": "带证据的可执行观察；不是订单，不携带任何写操作。",
      "properties": {
        "direction": {
          "$ref": "#/$defs/SetupDirection"
        },
        "entry_high": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Entry High",
          "type": "string"
        },
        "entry_low": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Entry Low",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "maxItems": 40,
          "title": "Evidence Refs",
          "type": "array"
        },
        "invalidation_stop": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Invalidation Stop",
          "type": "string"
        },
        "max_position": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Position"
        },
        "summary": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "take_profit": {
          "items": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Take Profit",
          "type": "array"
        },
        "valid_until": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        }
      },
      "required": [
        "direction",
        "summary",
        "entry_low",
        "entry_high",
        "invalidation_stop",
        "take_profit"
      ],
      "title": "SetupInsight",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "宿主回调；二选一给出 insight 或 abstain，也可只回文本让服务端解析。",
  "properties": {
    "abstain": {
      "anyOf": [
        {
          "$ref": "#/$defs/Abstain"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "dsh_session_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dsh Session Id"
    },
    "dsh_turn_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dsh Turn Id"
    },
    "error": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "insight": {
      "anyOf": [
        {
          "$ref": "#/$defs/SetupInsight"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "text": {
      "anyOf": [
        {
          "maxLength": 20000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text"
    }
  },
  "title": "HostResultRequest",
  "type": "object"
}
