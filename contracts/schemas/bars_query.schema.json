        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "可获取时间上界（含）",
      "title": "As Of"
    },
    "end": {
      "anyOf": [
        {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
