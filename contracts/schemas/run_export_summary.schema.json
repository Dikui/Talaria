{
  "$defs": {
    "RunAccountCurrencySummary": {
      "additionalProperties": false,
      "description": "按 `(sub_account_id, currency)` 聚合的回放收益与回撤汇总。",
      "properties": {
        "currency": {
          "minLength": 1,
          "title": "Currency",
          "type": "string"
        },
        "fees": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Fees",
          "type": "string"
        },
        "final_equity": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Equity"
        },
        "funding": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Funding",
          "type": "string"
        },
        "initial_capital": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Initial Capital"
        },
        "liquidation_fees": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Liquidation Fees",
          "type": "string"
        },
        "max_drawdown": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Max Drawdown",
          "type": "string"
        },
        "net_pnl": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Net Pnl",
          "type": "string"
        },
        "round_count": {
          "minimum": 0,
          "title": "Round Count",
          "type": "integer"
        },
        "sub_account_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Sub Account Id",
          "type": "string"
        },
        "trade_count": {
          "minimum": 0,
          "title": "Trade Count",
          "type": "integer"
        }
      },
      "required": [
        "sub_account_id",
        "currency",
        "round_count",
        "trade_count",
        "net_pnl",
        "max_drawdown",
        "fees",
        "funding",
        "liquidation_fees"
      ],
      "title": "RunAccountCurrencySummary",
      "type": "object"
    },
    "RunExportArtifacts": {
      "additionalProperties": false,
      "description": "`runs/<run_id>/` 下由账户进程原子产出的导出文件相对路径。",
      "properties": {
        "equity_path": {
          "default": "equity.parquet",
          "title": "Equity Path",
          "type": "string"
        },
        "overlays_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Overlays Path"
        },
        "rounds_path": {
          "default": "rounds.parquet",
          "title": "Rounds Path",
          "type": "string"
        }
      },
      "title": "RunExportArtifacts",
      "type": "object"
    },
    "RunStatus": {
      "description": "回放运行终态。",
      "enum": [
        "succeeded",
        "failed"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "`summary.json` 原子就绪标记与回放元数据摘要。",
  "properties": {
    "accounts": {
      "items": {
        "$ref": "#/$defs/RunAccountCurrencySummary"
      },
      "title": "Accounts",
      "type": "array"
    },
    "artifacts": {
      "$ref": "#/$defs/RunExportArtifacts"
    },
    "end": {
      "anyOf": [
        {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "fill_plugin": {
      "minLength": 1,
      "title": "Fill Plugin",
      "type": "string"
    },
    "instrument_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Instrument Id"
    },
    "instruments": {
      "items": {
        "type": "string"
      },
      "title": "Instruments",
      "type": "array"
    },
    "pnl_basis": {
      "const": "booked",
      "default": "booked",
      "title": "Pnl Basis",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scheme": {
      "minLength": 1,
      "title": "Scheme",
      "type": "string"
    },
    "signal_bars": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signal Bars"
    },
    "start": {
      "anyOf": [
        {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Start"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "timeframe": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Timeframe"
    }
  },
  "required": [
    "run_id",
    "status",
    "scheme",
    "fill_plugin"
  ],
  "title": "RunExportSummary",
  "type": "object"
}
