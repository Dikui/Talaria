{
  "$defs": {
    "Direction": {
      "enum": [
        "LONG",
        "SHORT"
      ],
      "type": "string"
    },
    "ExitBarrierSpec": {
      "additionalProperties": false,
      "properties": {
        "max_holding_ms": {
          "exclusiveMinimum": 0,
          "title": "Max Holding Ms",
          "type": "integer"
        },
        "stop": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Stop",
          "type": "string"
        },
        "take_profit": {
          "items": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Take Profit",
          "type": "array"
        },
        "trailing_stop": {
          "anyOf": [
            {
              "$ref": "#/$defs/TrailingStopSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "stop",
        "take_profit",
        "max_holding_ms"
      ],
      "title": "ExitBarrierSpec",
      "type": "object"
    },
    "TrailingStopSpec": {
      "additionalProperties": false,
      "properties": {
        "activation_pct": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Activation Pct",
          "type": "string"
        },
        "distance_pct": {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "title": "Distance Pct",
          "type": "string"
        }
      },
      "required": [
        "activation_pct",
        "distance_pct"
      ],
      "title": "TrailingStopSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "barriers": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExitBarrierSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "closed_ts": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Closed Ts"
    },
    "direction": {
      "$ref": "#/$defs/Direction"
    },
    "entry_high": {
      "anyOf": [
        {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Entry High"
    },
    "entry_low": {
      "anyOf": [
        {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Entry Low"
    },
    "entry_price": {
      "anyOf": [
        {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Entry Price"
    },
    "instrument_id": {
      "title": "Instrument Id",
      "type": "string"
    },
    "mark_price": {
      "anyOf": [
        {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mark Price"
    },
    "opened_ts": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Opened Ts"
    },
    "phase": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Phase"
    },
    "quantity": {
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
      "title": "Quantity",
      "type": "string"
    },
    "round_id": {
      "title": "Round Id",
      "type": "string"
    },
    "stop": {
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
      "title": "Stop",
      "type": "string"
    },
    "sub_account_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Sub Account Id",
      "type": "string"
    },
    "take_profit": {
      "default": [],
      "items": {
        "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
        "type": "string"
      },
      "title": "Take Profit",
      "type": "array"
    },
    "unrealized_pnl": {
      "anyOf": [
        {
          "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unrealized Pnl"
    }
  },
  "required": [
    "round_id",
    "sub_account_id",
    "instrument_id",
    "direction",
    "quantity",
    "stop"
  ],
  "title": "PaperRound",
  "type": "object"
}
