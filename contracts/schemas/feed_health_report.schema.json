{
  "$defs": {
    "FeedHealthEvent": {
      "additionalProperties": false,
      "description": "单标的供流健康。``stale_since`` 是最后一次收到传输活动的时刻。",
      "properties": {
        "instrument_id": {
          "title": "Instrument Id",
          "type": "string"
        },
        "last_event_ts": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Event Ts"
        },
        "reconnect_count": {
          "default": 0,
          "minimum": 0,
          "title": "Reconnect Count",
          "type": "integer"
        },
        "stale_since": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stale Since"
        },
        "status": {
          "$ref": "#/$defs/FeedHealthStatus"
        },
        "ts": {
          "title": "Ts",
          "type": "integer"
        }
      },
      "required": [
        "instrument_id",
        "status",
        "ts"
      ],
      "title": "FeedHealthEvent",
      "type": "object"
    },
    "FeedHealthStatus": {
      "description": "供流健康状态。",
      "enum": [
        "LIVE",
        "STALE",
        "RECOVERING"
      ],
      "title": "FeedHealthStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "快通道健康查询的响应：整体状态 + 每个订阅通道的明细。",
  "properties": {
    "channels": {
      "items": {
        "$ref": "#/$defs/FeedHealthEvent"
      },
      "title": "Channels",
      "type": "array"
    },
    "feed_mode": {
      "title": "Feed Mode",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/FeedHealthStatus"
    }
  },
  "required": [
    "feed_mode",
    "status",
    "channels"
  ],
  "title": "FeedHealthReport",
  "type": "object"
}
