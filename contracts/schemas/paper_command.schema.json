{
  "$defs": {
    "PaperCommandKind": {
      "description": "人工干预命令类型。",
      "enum": [
        "TIGHTEN_STOP",
        "MOVE_TO_BREAKEVEN",
        "WIDEN_STOP",
        "MODIFY_TAKE_PROFIT",
        "CANCEL_ENTRY",
        "CLOSE_ALL",
        "REDUCE_RATIO",
        "SET_TRADING_STATE"
      ],
      "title": "PaperCommandKind",
      "type": "string"
    },
    "PaperCommandPayload": {
      "additionalProperties": false,
      "description": "人工干预命令的参数载荷，全部价格与比例均为十进制字符串。",
      "properties": {
        "ratio": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ratio"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "stop": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop"
        },
        "take_profit": {
          "anyOf": [
            {
              "items": {
                "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
                "type": "string"
              },
              "maxItems": 4,
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Take Profit"
        },
        "trading_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/TradingState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "PaperCommandPayload",
      "type": "object"
    },
    "TradingState": {
      "description": "子账户或全局系统交易状态。",
      "enum": [
        "ACTIVE",
        "REDUCING",
        "HALTED"
      ],
      "title": "TradingState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "常驻服务出站至模拟盘账户进程的人工干预命令。",
  "properties": {
    "based_on_ledger_seq": {
      "minimum": 0,
      "title": "Based On Ledger Seq",
      "type": "integer"
    },
    "command_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Command Id",
      "type": "string"
    },
    "issued_by": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Issued By",
      "type": "string"
    },
    "issued_ts": {
      "minimum": 0,
      "title": "Issued Ts",
      "type": "integer"
    },
    "kind": {
      "$ref": "#/$defs/PaperCommandKind"
    },
    "payload": {
      "$ref": "#/$defs/PaperCommandPayload"
    },
    "round_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Round Id"
    },
    "sub_account_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Sub Account Id",
      "type": "string"
    }
  },
  "required": [
    "command_id",
    "sub_account_id",
    "kind",
    "based_on_ledger_seq",
    "issued_by",
    "issued_ts"
  ],
  "title": "PaperCommand",
  "type": "object"
}
