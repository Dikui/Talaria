{
  "name": "@talaria/dsh-plugin",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./tools": "./tools.js",
    "./client": "./client/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "tools.js",
    "bridge.js",
    "guard.js",
    "service-supervisor.js",
    "*.tool.json",
    "client/index.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.mjs",
    "build": "node scripts/build-client.mjs"
  },
  "devDependencies": {
    "@talaria/desk-ui": "workspace:*",
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.3.8"
  }
}
