                  "SWING_HIGH",
                  "SWING_LOW",
                  "PREV_DAY_HIGH",
                  "PREV_DAY_LOW",
                  "PREV_DAY_CLOSE",
                  "WEEK_OPEN",
                  "MONTH_OPEN",
                  "OPENING_RANGE",
                  "SESSION_HIGH",
                  "SESSION_LOW",
                  "GAP",
                  "ROUND_NUMBER",
                  "POC",
                  "VAH",
