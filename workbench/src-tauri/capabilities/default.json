{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for Talaria Workbench multi-window shell",
  "windows": ["main", "popout-*"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-create",
    "core:webview:default",
    "core:webview:allow-create-webview-window"
  ]
}
