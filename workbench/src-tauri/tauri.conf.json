{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Talaria Workbench",
  "version": "0.1.0",
  "identifier": "dev.talaria.workbench",
  "build": {
    "beforeDevCommand": "pnpm -C ../packages/talaria-desk-ui dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm -C ../packages/talaria-desk-ui build",
    "frontendDist": "../packages/talaria-desk-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Talaria Workbench",
        "width": 1440,
        "height": 900,
        "minWidth": 390,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
